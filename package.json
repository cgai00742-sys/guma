{
  "name": "guma",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "migrations:lock": "node -e \"const fs=require('fs'),c=require('crypto'),p=require('path'),d='src-tauri/migrations',o={};for(const f of fs.readdirSync(d).filter(f=>f.endsWith('.sql')).sort())o[f]=c.createHash('sha384').update(fs.readFileSync(p.join(d,f))).digest('hex');fs.writeFileSync(p.join(d,'checksums.json'),JSON.stringify(o,null,2)+'\\n');console.log('locked',Object.keys(o).length,'migrations')\"",
    "db:repair": "node scripts/repair-migrations.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-sql": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
